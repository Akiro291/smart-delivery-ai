# PostgreSQL Environment
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=smart_delivery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/smart_delivery

# Redis Environment
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Environment
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT Configuration — ОБЯЗАТЕЛЬНО замените SECRET_KEY!
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI API (опционально)
OPENAI_API_KEY=

# Telegram Bot (опционально)
TELEGRAM_BOT_TOKEN=

# Email Configuration (опционально)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@smartdelivery.ai

# CORS — разрешённые origin через запятую
CORS_ORIGINS=http://localhost:3000

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Docker
DOCKER_ENV=true
